<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gray rounded background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#707070"/>
        </shape>
    </item>

    <!-- Top block (black) - fixed height -->
    <item android:bottom="10dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#f0f0f0"/>
        </shape>
    </item>

    <!-- Bottom block (white) -->
    <item android:top="13dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#d9d9d9"/>
        </shape>
    </item>
</layer-list>